# Dockerfile.streamlit
#
# A second Dockerfile specifically for the Streamlit frontend.
# We use a separate file (not the same Dockerfile as the API) because
# the two services run different commands and it keeps things clear —
# in a bigger project you might split them into entirely separate folders,
# but this is a reasonable middle ground for a project this size.

FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev

COPY . .

EXPOSE 8501

CMD ["uv", "run", "streamlit", "run", "app.py", "--server.address=0.0.0.0"]
